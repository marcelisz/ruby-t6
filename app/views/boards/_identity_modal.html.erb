<div class="modal fade" id="identityModal" tabindex="-1" aria-labelledby="identityModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content modal-surface modal-surface--compact">
      <div class="modal-header modal-surface__header">
        <div class="modal-heading">
          <span class="modal-heading__icon"><i class="bi bi-person"></i></span>
          <div>
            <h2 class="modal-title" id="identityModalLabel">Change your nickname</h2>
            <p>This is how your cursor appears to others.</p>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>

      <%= form_with url: profile_path, method: :patch, local: true, class: "modal-form" do %>
        <div class="modal-body modal-surface__body">
          <div class="form-field">
            <label for="profile_nickname">Nickname</label>
            <input
              id="profile_nickname"
              name="nickname"
              type="text"
              class="form-control form-control-lg"
              value="<%= current_nickname %>"
              maxlength="32"
              autocomplete="nickname"
              required
            >
          </div>
          <p class="form-note"><i class="bi bi-info-circle"></i> Existing marks keep the name you had when you drew them.</p>
        </div>
        <div class="modal-footer modal-surface__footer">
          <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save nickname</button>
        </div>
      <% end %>
    </div>
  </div>
</div>
