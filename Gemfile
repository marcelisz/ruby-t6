source "https://rubygems.org"

# Rails application framework.
gem "rails", "~> 8.1.4"

# Asset pipeline for the self-contained frontend.
gem "propshaft"

# Persistent store for boards and every stroke drawn on them.
gem "sqlite3", ">= 2.1"

# Web server (HTTP + WebSocket).
gem "puma", ">= 5.0"

# Keep the resolver away from an io-console release that needs a native rebuild
# on the Windows host; the Ruby distribution already ships a compatible copy.
gem "io-console", "0.8.2"

# Windows does not include zoneinfo files.
gem "tzinfo-data", platforms: %i[windows jruby]
